# Copy to .env (git-ignored) and change the values. Compose falls back to the dev defaults shown here.
POSTGRES_PASSWORD=postgres
CONFIG_USER=config
CONFIG_PASSWORD=config-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Optional: serve configuration from a Git repository instead of the local config-repo folder ---
# CONFIG_BACKEND=git
# GIT_URI=https://github.com/<you>/shopstream-config
# GIT_BRANCH=main
# GIT_USERNAME=<your-github-username>
# GIT_TOKEN=<fine-grained personal access token with read-only Contents access>
